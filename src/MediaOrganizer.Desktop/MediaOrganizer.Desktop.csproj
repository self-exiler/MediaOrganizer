<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- 发布瘦身：只随包分发简体中文与英文卫星资源 -->
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 发布瘦身 + 单一运行时（ADR-0009）：
       1) SkiaSharp / HarfBuzzSharp 的原生资产包把 libSkiaSharp.pdb(82MB)、libHarfBuzzSharp.pdb(20MB)
          一起拷进发布目录，对终端用户毫无价值。它们属于 native runtime asset，不受 DebugType 控制，
          只能在 Publish 后清理。
       2) 指定 RuntimeIdentifier 时，所需原生库已扁平化到根目录，runtimes\ 下其余 7 个平台的
          原生库（约 476MB）纯属冗余。仅在 RID 发布时删除——RID 无关发布仍需靠 runtimes\ 定位。 -->
  <Target Name="PrunePublishOutput" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_PublishSymbols Include="$(PublishDir)**\*.pdb" />
      <_ForeignRuntimes Include="$(PublishDir)runtimes\**\*" />
    </ItemGroup>
    <Delete Files="@(_PublishSymbols);@(_ForeignRuntimes)" />
    <RemoveDir Directories="$(PublishDir)runtimes" />
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <!-- Avalonia 12 把 HarfBuzz 文本整形拆成可选包：只 UseSkia() 不接整形系统会在启动时抛
         "No text shaping system configured"，中文/拉丁混排也无法正确成形。 -->
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <!-- 试过去掉嵌入式 Inter 字体（省 1.9MB）：实测启动 1891ms → 2088ms，无收益反而略慢
         （默认字体回退到系统字体解析）。保留 Inter，别再动它。 -->
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaOrganizer.Core\MediaOrganizer.Core.csproj" />
    <ProjectReference Include="..\MediaOrganizer.Shared\MediaOrganizer.Shared.csproj" />
  </ItemGroup>
</Project>
