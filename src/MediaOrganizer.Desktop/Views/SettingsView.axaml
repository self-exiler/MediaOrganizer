<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaOrganizer.Desktop.ViewModels"
             xmlns:svm="using:MediaOrganizer.Shared.ViewModels"
             x:Class="MediaOrganizer.Desktop.Views.SettingsView"
             x:DataType="svm:SettingsViewModel">

    <DockPanel Margin="24,20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
            <StackPanel>
                <TextBlock Classes="h1" Text="设置"/>
                <TextBlock Classes="muted" Text="提取器链 / 文件名模式 / 系统 / 界面" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="初始化默认配置" Command="{Binding InitializeCommand}"/>
            </StackPanel>
        </DockPanel>

        <TabControl Margin="0,8,0,0">
            <TabItem Header="提取器">
                <ScrollViewer>
                    <StackPanel Spacing="14" Margin="0,12,0,0">
                        <Border Classes="card">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="h2" Text="提取器加权链（按权重降序依次尝试）"/>
                                <ItemsControl ItemsSource="{Binding Extractors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="svm:ExtractorSettingVM">
                                            <Grid ColumnDefinitions="Auto,100,1*,80" ColumnSpacing="12" Margin="0,4">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                <Slider Grid.Column="2" Minimum="0" Maximum="2" TickFrequency="0.1"
                                                        Value="{Binding Weight, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Weight, StringFormat={}{0:0.0}}"
                                                           VerticalAlignment="Center" Classes="muted"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="h2" Text="日期校验"/>
                                <Grid ColumnDefinitions="100,140,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="最多追溯" VerticalAlignment="Center" Classes="muted"/>
                                    <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding MaxYearsPast}" Minimum="1" Maximum="60"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="年" VerticalAlignment="Center" Classes="muted"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="未来缓冲" VerticalAlignment="Center" Classes="muted"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding FutureDateBufferDays}" Minimum="0" Maximum="365"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="天" VerticalAlignment="Center" Classes="muted"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="文件名模式">
                <ScrollViewer>
                    <StackPanel Spacing="10" Margin="0,12,0,0">
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="1*,Auto" ColumnSpacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Classes="h2" Text="文件名模式"/>
                                        <TextBlock Classes="muted" Text="{Binding PatternSummary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Content="🪄 打开魔术工具" Command="{Binding OpenMagicToolsCommand}"/>
                                        <Button Content="恢复默认" Command="{Binding RestoreDefaultPatternsCommand}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                           Text="分析时按权重降序依次尝试。勾选/取消即时生效；删除后自动保存。"/>
                                <Grid ColumnDefinitions="Auto,140,1*,70,60,56" ColumnSpacing="8" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0" Text="启用" Classes="muted" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="名称" Classes="muted" FontSize="11"/>
                                    <TextBlock Grid.Column="2" Text="正则" Classes="muted" FontSize="11"/>
                                    <TextBlock Grid.Column="3" Text="权重" Classes="muted" FontSize="11"/>
                                    <TextBlock Grid.Column="4" Text="来源" Classes="muted" FontSize="11"/>
                                    <TextBlock Grid.Column="5" Text="操作" Classes="muted" FontSize="11"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Patterns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="svm:PatternSettingVM">
                                            <Grid ColumnDefinitions="Auto,140,1*,70,60,56" ColumnSpacing="8" Margin="0,4">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Regex}" VerticalAlignment="Center"
                                                           FontFamily="Cascadia Code, Consolas, monospace" FontSize="11.5"
                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Regex}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Weight, StringFormat={}{0:0.0}}" VerticalAlignment="Center" Classes="muted"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Source}" VerticalAlignment="Center" Classes="muted"/>
                                                <Button Grid.Column="5" Content="删除" Classes="danger" FontSize="11" Padding="6,2"
                                                        Command="{Binding $parent[ItemsControl].DataContext.DeletePatternCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="系统">
                <ScrollViewer>
                    <StackPanel Spacing="14" Margin="0,12,0,0">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="1*,Auto" ColumnSpacing="8">
                                    <TextBlock Classes="h2" Text="网络位置" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="＋ 添加网络位置" Classes="accent"
                                            Command="{Binding BeginAddNetworkCommand}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding NetworkProfiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="svm:NetworkProfileVM">
                                            <Grid ColumnDefinitions="Auto,140,1*,110,150" ColumnSpacing="8" Margin="0,4">
                                                <Border Grid.Column="0" Classes="chip" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeLabel}" FontSize="11"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Address}" VerticalAlignment="Center" Classes="muted"
                                                           FontFamily="Cascadia Code, Consolas, monospace" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Address}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding VerifiedLabel}" VerticalAlignment="Center" FontSize="11"/>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                                                    <Button Content="测试" FontSize="11" Padding="8,2"
                                                            Command="{Binding $parent[ItemsControl].DataContext.TestProfileCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="编辑" FontSize="11" Padding="8,2"
                                                            Command="{Binding $parent[ItemsControl].DataContext.BeginEditNetworkCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="删除" Classes="danger" FontSize="11" Padding="8,2"
                                                            Command="{Binding $parent[ItemsControl].DataContext.DeleteNetworkCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 内联编辑/新建表单 -->
                                <Border IsVisible="{Binding EditingNetwork}" CornerRadius="6" Padding="12"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="70,1*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" VerticalAlignment="Center" Classes="muted"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditName}" PlaceholderText="例如：家里的 NAS"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="协议" VerticalAlignment="Center" Classes="muted"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding NetworkTypeOptions}"
                                                      SelectedIndex="{Binding EditTypeIndex}"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="地址" VerticalAlignment="Center" Classes="muted"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditAddress}"
                                                     PlaceholderText="SMB: \\192.168.1.10\photos　WebDAV: https://dav.xxx.com/dav/photos"
                                                     FontFamily="Cascadia Code, Consolas, monospace"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="用户名" VerticalAlignment="Center" Classes="muted"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditUsername}"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="密码" VerticalAlignment="Center" Classes="muted"/>
                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EditPassword}" PasswordChar="●"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="测试连接" Command="{Binding TestNetworkCommand}"/>
                                            <Button Classes="accent" Content="保存" Command="{Binding SaveNetworkCommand}"/>
                                            <Button Content="取消" Command="{Binding CancelNetworkCommand}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding NetworkHint}" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="h2" Text="扫描与执行"/>
                                <Grid ColumnDefinitions="140,180,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="进度间隔" VerticalAlignment="Center" Classes="muted"/>
                                    <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding ProgressInterval}" Minimum="1" Maximum="1000"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="个文件" VerticalAlignment="Center" Classes="muted"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="扫描并发数" VerticalAlignment="Center" Classes="muted"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MaxDegreeOfParallelism}" Minimum="0" Maximum="64"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="0 = 自动" VerticalAlignment="Center" Classes="muted"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="执行并发数" VerticalAlignment="Center" Classes="muted"/>
                                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ExecutionParallelism}" Minimum="0" Maximum="64"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="0 = 自动（本地2/网络4）" VerticalAlignment="Center" Classes="muted"/>

                                    <CheckBox Grid.Row="3" Grid.Column="1" Content="扫描所有文件（忽略扩展名白名单）" IsChecked="{Binding ScanAllFiles}"/>
                                </Grid>
                                <TextBlock Classes="muted" FontSize="11" Text="扩展名白名单（逗号分隔，留空 = 全部）："/>
                                <TextBox Text="{Binding SupportedFormatsText, UpdateSourceTrigger=LostFocus}" FontSize="11.5"
                                         FontFamily="Cascadia Code, Consolas, monospace"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="界面">
                <ScrollViewer>
                    <StackPanel Spacing="10" Margin="0,12,0,0">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="h2" Text="界面"/>
                                <Grid ColumnDefinitions="100,180" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="主题" VerticalAlignment="Center" Classes="muted"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ThemeOptions}"
                                              SelectedIndex="{Binding ThemeIndex}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="窗口尺寸" VerticalAlignment="Center" Classes="muted"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WindowSize, UpdateSourceTrigger=LostFocus}" PlaceholderText="1280x760"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="预览图大小" VerticalAlignment="Center" Classes="muted"/>
                                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding PreviewSize}" Minimum="100" Maximum="1024"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
