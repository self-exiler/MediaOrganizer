<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaOrganizer.Desktop.ViewModels"
             x:Class="MediaOrganizer.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <DockPanel Margin="24,20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
            <StackPanel>
                <TextBlock Classes="h1" Text="设置"/>
                <TextBlock Classes="muted" Text="提取器链 / 文件名模式 / 系统 / 界面" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="保存配置" Classes="accent" Command="{Binding SaveConfigCommand}"/>
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding SaveHint}" Foreground="#107C10" FontSize="11" Margin="0,-6,0,8"/>

        <TabControl Margin="0,8,0,0">
            <TabItem Header="提取器">
                <ScrollViewer>
                    <StackPanel Spacing="14" Margin="0,12,0,0">
                        <Border Classes="card">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="h2" Text="提取器加权链（按权重降序依次尝试）"/>
                                <ItemsControl ItemsSource="{Binding Extractors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ExtractorSettingVM">
                                            <Grid ColumnDefinitions="Auto,100,1*,80" ColumnSpacing="12" Margin="0,4">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                <Slider Grid.Column="2" Minimum="0" Maximum="2" TickFrequency="0.1"
                                                        Value="{Binding Weight, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Weight, StringFormat={}{0:0.0}}"
                                                           VerticalAlignment="Center" Classes="muted"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="h2" Text="日期校验"/>
                                <Grid ColumnDefinitions="100,140,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="最多追溯" VerticalAlignment="Center" Classes="muted"/>
                                    <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding MaxYearsPast}" Minimum="1" Maximum="60"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="年" VerticalAlignment="Center" Classes="muted"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="未来缓冲" VerticalAlignment="Center" Classes="muted"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding FutureDateBufferDays}" Minimum="0" Maximum="365"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="天" VerticalAlignment="Center" Classes="muted"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="文件名模式">
                <ScrollViewer>
                    <StackPanel Spacing="10" Margin="0,12,0,0">
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="h2" Text="文件名模式"/>
                                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                           Text="patterns.json 中的规则由「魔术工具」维护。分析时按权重降序尝试。"/>
                                <TextBlock Classes="muted" FontSize="12" Text="内置 8 条：微信导出 / 小红书 / 通用日期时间 / 通用日期 / 紧凑日期时间 / 紧凑日期 / 秒级时间戳 / 毫秒级时间戳。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="系统">
                <ScrollViewer>
                    <StackPanel Spacing="14" Margin="0,12,0,0">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="h2" Text="路径"/>
                                <Grid ColumnDefinitions="90,1*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="源目录" VerticalAlignment="Center" Classes="muted"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SourceDir}"/>
                                    <Button Grid.Row="0" Grid.Column="2" Content="浏览…" Command="{Binding BrowseSourceCommand}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="输出目录" VerticalAlignment="Center" Classes="muted"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OutputDir}"/>
                                    <Button Grid.Row="1" Grid.Column="2" Content="浏览…" Command="{Binding BrowseOutputCommand}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="待处理" VerticalAlignment="Center" Classes="muted"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PendingDir}"/>
                                    <Button Grid.Row="2" Grid.Column="2" Content="浏览…" Command="{Binding BrowsePendingCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="h2" Text="扫描与执行"/>
                                <Grid ColumnDefinitions="120,160,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="进度间隔" VerticalAlignment="Center" Classes="muted"/>
                                    <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding ProgressInterval}" Minimum="1" Maximum="1000"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="个文件" VerticalAlignment="Center" Classes="muted"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="预览图大小" VerticalAlignment="Center" Classes="muted"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding PreviewSize}" Minimum="100" Maximum="1024"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="px" VerticalAlignment="Center" Classes="muted"/>
                                </Grid>
                                <TextBlock Classes="muted" FontSize="11"
                                           Text="支持的扩展名白名单、并发数、扫描所有文件等高级项当前在 config.json 中手工维护（见 SRS §5.1）。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="界面">
                <ScrollViewer>
                    <StackPanel Spacing="10" Margin="0,12,0,0">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="h2" Text="界面"/>
                                <Grid ColumnDefinitions="100,180" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="主题" VerticalAlignment="Center" Classes="muted"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ThemeOptions}"
                                              SelectedIndex="{Binding ThemeIndex}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="语言" VerticalAlignment="Center" Classes="muted"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding LanguageOptions}"
                                              SelectedIndex="0"/>
                                </Grid>
                                <TextBlock Classes="muted" FontSize="11" Text="首发仅简体中文；文本资源已外置（见 SRS NFR-8），英文将后续补充。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
