<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:MediaOrganizer.Desktop.Views"
        x:Class="MediaOrganizer.Desktop.Views.ConfirmDialog"
        x:DataType="views:ConfirmViewModel"
        Title="{Binding Title}" Width="420" Height="180"
        WindowStartupLocation="CenterOwner" CanResize="False"
        ShowInTaskbar="False">
    <DockPanel Margin="20" LastChildFill="False">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="取消" IsCancel="True"/>
            <Button Content="确定" Classes="accent" IsDefault="True" Click="OnConfirm"/>
        </StackPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14"/>
    </DockPanel>
</Window>
