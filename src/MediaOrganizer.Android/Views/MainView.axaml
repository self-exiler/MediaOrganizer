<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MediaOrganizer.Android"
             xmlns:vm="using:MediaOrganizer.Android.ViewModels"
             x:Class="MediaOrganizer.Android.Views.MainView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <!-- 抽屉导航按钮（固定 4 项）：48dp 热区、选中态左侧 3px 高亮条 + 淡色圆角底。
             本轮 GUI 优化后「ListBox + 自定义 ItemContainerTheme」在真机上只生成首个容器，
             表现为侧栏只剩「整理工作台」；固定导航项改为静态按钮，彻底绕开容器生成/虚拟化路径。
             选中态由 MainView.UpdateNavSelection 按 SelectedPage 切 Classes.selected。 -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0,24,24,0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>
        <Style Selector="Button.nav.selected">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
        </Style>
        <Style Selector="Button.nav:pressed">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
        </Style>
        <!-- 抽屉遮罩基态（关）：注意 Opacity/IsHitTestVisible 必须走样式而非本地属性——
             Avalonia 本地值优先级高于样式 Setter，写在元素上会令 .open 态失效 -->
        <Style Selector="Border#DrawerOverlay">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Border#DrawerOverlay.open">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
        <!-- 抽屉开合：RenderTransform 平移（TransformOperationsTransition 动画），关=屏外、开=原位 -->
        <Style Selector="Border#Drawer">
            <Setter Property="RenderTransform" Value="translateX(-280px)"/>
        </Style>
        <Style Selector="Border#Drawer.open">
            <Setter Property="RenderTransform" Value="translateX(0px)"/>
        </Style>
    </UserControl.Styles>

    <Grid x:Name="Root" RowDefinitions="Auto,*"
          Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}">

        <!-- AppBar（FR-A7.1）：汉堡菜单 + 页面标题，固定 56dp（审查报告3 F6 保留品牌色）。
             不再把状态栏 insets 叠进色带高度：真机上会把顶部蓝块撑成近 200dp，见 MainView.ApplyInsets。
             汉堡字符 ≡ 换矢量 PathIcon（审查报告2 F8、报告3 F5）。 -->
        <Border x:Name="AppBar" Grid.Row="0" Background="{DynamicResource AccentBrush}" MinHeight="56">
            <DockPanel x:Name="AppBarContent" VerticalAlignment="Bottom" Height="56" Margin="4,0">
                <Button DockPanel.Dock="Left" Command="{Binding ToggleDrawerCommand}"
                        Background="Transparent" BorderThickness="0" Foreground="White"
                        Width="48" Height="48" VerticalAlignment="Center">
                    <PathIcon Data="{x:Static local:AppIcons.Menu}" Width="20" Height="20" Foreground="White"/>
                </Button>
                <TextBlock Text="{Binding AppTitle}" Foreground="White" FontSize="{StaticResource FontSizeTitle}" FontWeight="Medium"
                           VerticalAlignment="Center" Margin="4,0,12,0"/>
            </DockPanel>
        </Border>

        <!-- 内容区：4 个页面视图常驻（VM 进程级单例），仅切 IsVisible —— 保留滚动位置/展开详情/编辑表单
             （审查报告3 P1：原 ContentControl+ViewLocator 每次切换重建视图丢状态）。 -->
        <Panel x:Name="PageHost" Grid.Row="1">
            <ContentControl x:Name="PageWorkbench" Content="{Binding Workbench}"/>
            <ContentControl x:Name="PageFailed" Content="{Binding FailedFiles}" IsVisible="False"/>
            <ContentControl x:Name="PageReport" Content="{Binding Report}" IsVisible="False"/>
            <ContentControl x:Name="PageSettings" Content="{Binding Settings}" IsVisible="False"/>
        </Panel>

        <!-- 操作反馈轻提示（审查报告1 #8：常驻底部状态栏移除）：非忙碌时状态文本弹出，3.5s 自动消失，
             不拦截触摸；忙碌进度仍由工作台进行中卡片/结果卡片承载。 -->
        <Border x:Name="Toast" Grid.Row="0" Grid.RowSpan="2" ZIndex="200"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Background="#F0202020" CornerRadius="20" Padding="16,10"
                IsHitTestVisible="False" Opacity="0" MaxWidth="480">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                </Transitions>
            </Border.Transitions>
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="{StaticResource FontSizeBody}"
                       TextWrapping="Wrap" MaxLines="3"/>
        </Border>

        <!-- 抽屉遮罩 + 抽屉：两元素常驻视觉树，遮罩淡入淡出、抽屉滑入滑出（审查报告2 F5、报告3 抽屉动画），
             关闭态整体不命中（IsHitTestVisible=False），不依赖 IsVisible 硬切。 -->
        <Panel Grid.Row="0" Grid.RowSpan="2" ZIndex="100" ClipToBounds="True">
            <Border x:Name="DrawerOverlay" Classes.open="{Binding DrawerOpen}"
                    Background="#66000000"
                    Tapped="OnOverlayTapped">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    </Transitions>
                </Border.Transitions>
            </Border>
            <Border x:Name="Drawer" HorizontalAlignment="Left" Width="280"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    Classes.open="{Binding DrawerOpen}">
                <Border.Transitions>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    </Transitions>
                </Border.Transitions>
                <DockPanel>
                    <!-- 抽屉头部：logo + 应用名 -->
                    <StackPanel DockPanel.Dock="Top" Margin="20,18,20,10" Orientation="Horizontal" Spacing="12">
                        <Border Width="36" Height="36" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="#0067C0" Offset="0"/>
                                    <GradientStop Color="#4FA3E3" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="MO" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="MediaOrganizer" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Padding="20,10">
                        <StackPanel>
                            <TextBlock Text="{Binding VersionText}" FontSize="{StaticResource FontSizeSecondary}"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            <TextBlock Text="APK 侧载分发（GitHub Release）" FontSize="{StaticResource FontSizeSecondary}"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- 静态导航项：4 个页面固定，不依赖 ItemsSource/容器生成（见 UserControl.Styles 注释） -->
                    <StackPanel Margin="0,4" Spacing="2">
                        <Button x:Name="Nav0" Classes="nav" Tag="0" Click="OnNavClicked">
                            <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="48">
                                <PathIcon Grid.Column="0" Data="{x:Static local:AppIcons.Folder}" Width="20" Height="20"
                                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="整理工作台" FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </Grid>
                        </Button>
                        <Button x:Name="Nav1" Classes="nav" Tag="1" Click="OnNavClicked">
                            <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="48">
                                <PathIcon Grid.Column="0" Data="{x:Static local:AppIcons.Alert}" Width="20" Height="20"
                                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="失败文件" FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                                <!-- 失败文件角标：由 code-behind 按 FailedBadge 刷新（0 时隐藏） -->
                                <Border x:Name="NavBadge" Grid.Column="2" IsVisible="False"
                                        Background="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                        CornerRadius="99" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="NavBadgeText" Text="0" FontSize="{StaticResource FontSizeSecondary}" Foreground="White"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button x:Name="Nav2" Classes="nav" Tag="2" Click="OnNavClicked">
                            <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="48">
                                <PathIcon Grid.Column="0" Data="{x:Static local:AppIcons.Document}" Width="20" Height="20"
                                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="分析报告" FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </Grid>
                        </Button>
                        <Button x:Name="Nav3" Classes="nav" Tag="3" Click="OnNavClicked">
                            <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="48">
                                <PathIcon Grid.Column="0" Data="{x:Static local:AppIcons.Tune}" Width="20" Height="20"
                                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="设置" FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Panel>
    </Grid>
</UserControl>
