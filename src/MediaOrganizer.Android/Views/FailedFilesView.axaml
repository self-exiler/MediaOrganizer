<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaOrganizer.Shared.ViewModels"
             x:Class="MediaOrganizer.Android.Views.FailedFilesView"
             x:DataType="vm:FailedFilesViewModel">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C"/>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0">
            <StackPanel Margin="16" Spacing="12">

                <!-- 警示条（FR-A6.1） -->
                <Border Background="#FFF9F5" BorderBrush="#F4D1BC" BorderThickness="1" CornerRadius="8"
                        Padding="12,10">
                    <TextBlock FontSize="13" Foreground="#8A3714" TextWrapping="Wrap"
                               Text="⚠ 以下文件未能提取日期，已按文件名结构指纹聚类。可勾选后批量移动到待处理目录，或在桌面版用魔术工具添加规则后重新分析。"/>
                </Border>

                <!-- 移动进行中进度 -->
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" IsVisible="{Binding IsMoving}">
                    <StackPanel Spacing="8">
                        <ProgressBar MinHeight="6" Value="{Binding MoveProgress}" Maximum="100"/>
                        <TextBlock Text="正在移动到待处理目录…" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>

                <!-- 移动结果提示 -->
                <Border Background="#F2FBF2" BorderBrush="#BFE6BF" BorderThickness="1" CornerRadius="8"
                        Padding="12,10" IsVisible="{Binding MoveHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding MoveHint}" FontSize="13" Foreground="#0B5A0B" TextWrapping="Wrap"/>
                </Border>

                <!-- 列表卡片（FR-A6.1/A6.2/A6.3）：勾选 + 名称/路径/大小 + 失败原因 chip + 展开详情 -->
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="4,8,16,8"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                        BoxShadow="0 1 3 0 #14000000">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FailedItem">
                                <StackPanel>
                                    <Grid ColumnDefinitions="Auto,8,*" MinHeight="56">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" VerticalAlignment="Center"/>
                                        <ToggleButton Grid.Column="2" x:Name="Row" Background="Transparent"
                                                      BorderThickness="0" HorizontalContentAlignment="Stretch"
                                                      HorizontalAlignment="Stretch" Padding="0,8">
                                            <Grid ColumnDefinitions="*,Auto" MinHeight="48">
                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Path}" FontSize="11"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                                        <Border Background="#FDECEB" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Reason}" FontSize="10" Foreground="#A4262C"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="›" FontSize="18"
                                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ToggleButton>
                                    </Grid>

                                    <!-- 展开详情（FR-A6.3）：完整路径 / 大小 / 原因 / 系统打开 -->
                                    <Border IsVisible="{Binding #Row.IsChecked}" Margin="32,0,0,12"
                                            Background="#FAFAFA" CornerRadius="8" Padding="12,8">
                                        <StackPanel Spacing="4">
                                            <TextBlock FontSize="12" Foreground="#616161" TextWrapping="Wrap">
                                                <Run Text="完整路径："/><Run Text="{Binding Path}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="#616161">
                                                <Run Text="大小："/><Run Text="{Binding Size}"/><Run Text=" 字节"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="#616161" TextWrapping="Wrap">
                                                <Run Text="指纹："/><Run Text="{Binding Fingerprint}"/>
                                            </TextBlock>
                                            <Button Content="↗ 用系统应用打开" FontSize="12" MinHeight="36" Margin="0,4,0,0"
                                                    HorizontalAlignment="Left" Click="OnOpenItem"/>
                                        </StackPanel>
                                    </Border>

                                    <Separator Background="#F0F0F0" Margin="0,4"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部批量操作栏（FR-A6.5） -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" Padding="16,12"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,8,*">
                <Button Grid.Column="0" Content="全选" Command="{Binding ToggleSelectAllCommand}"
                        IsEnabled="{Binding !IsMoving}"/>
                <Button Grid.Column="2" Content="批量移动到待处理" Classes="primary"
                        Command="{Binding MoveToPendingCommand}" IsEnabled="{Binding !IsMoving}"/>
            </Grid>
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#0067C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#1975C5"/>
        </Style>
    </UserControl.Styles>
</UserControl>
