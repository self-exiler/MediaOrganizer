<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MediaOrganizer.Android"
             xmlns:vm="using:MediaOrganizer.Shared.ViewModels"
             x:Class="MediaOrganizer.Android.Views.FailedFilesView"
             x:DataType="vm:FailedFilesViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 顶部非滚动提示区：警示 / 移动进度 / 结果（P2-8：从整页滚动中拆出，列表区独立滚动以虚拟化） -->
        <StackPanel Grid.Row="0" Margin="16,16,16,0" Spacing="12">
            <!-- 警示条（FR-A6.1）：⚠ 字符图标移除，改语义提示条样式（审查报告1 #2、报告3 F5） -->
            <Border Classes="tip warnTip" Padding="12,10">
                <TextBlock FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap"
                           Text="以下文件未能提取日期，已按文件名结构指纹聚类。可勾选后批量移动到待处理目录，或在桌面版用魔术工具添加规则后重新分析。"/>
            </Border>

            <!-- 移动进行中进度 -->
            <Border Classes="card" IsVisible="{Binding IsMoving}">
                <StackPanel Spacing="8">
                    <ProgressBar MinHeight="6" Value="{Binding MoveProgress}" Maximum="100"/>
                    <TextBlock Text="正在移动到待处理目录…" FontSize="{StaticResource FontSizeSecondary}"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
            </Border>

            <!-- 移动结果提示 -->
            <Border Classes="tip successTip" Padding="12,10"
                    IsVisible="{Binding MoveHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding MoveHint}" FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- 列表卡片（FR-A6.1/A6.2/A6.3）：勾选 + 名称/路径/大小 + 失败原因 chip + 展开详情。
             P2-8：原 ScrollViewer 套 ItemsControl 不虚拟化，上千失败文件一次性实例化上千模板；
             改独立滚动的虚拟化 ListBox，失败条目多时流畅。 -->
        <Border Grid.Row="1" Margin="16,12,16,12"
                Classes="card" Padding="4,8,16,8">
            <!-- Avalonia 的 SelectionMode 枚举只有 Single/Multiple/Toggle/AlwaysSelected，
                 没有 None（写成 "None" 会报 AVLN3000）。本列表只当虚拟化容器用，勾选语义走行内 CheckBox，
                 故不设 SelectionMode（默认 Single），改把选中底色覆写成透明，选中态不可见。 -->
            <ListBox ItemsSource="{Binding Items}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent">
                <ListBox.Resources>
                    <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="Transparent"/>
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="Transparent"/>
                    <!-- 选中底色透明，前景保持主题正文色（经主题刷别名，随深浅色切换） -->
                    <StaticResource x:Key="ListBoxItemForegroundSelected" ResourceKey="SystemControlForegroundBaseHighBrush"/>
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FailedItem">
                        <StackPanel>
                            <Grid ColumnDefinitions="Auto,8,*" MinHeight="56">
                                <!-- 48dp 勾选热区（审查报告2 M9） -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" MinWidth="48" MinHeight="48"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ToggleButton Grid.Column="2" x:Name="Row" Background="Transparent"
                                              BorderThickness="0" HorizontalContentAlignment="Stretch"
                                              HorizontalAlignment="Stretch" Padding="0,8">
                                    <Grid ColumnDefinitions="*,Auto" MinHeight="48">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeBody}" FontWeight="Medium"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" TextTrimming="CharacterEllipsis"/>
                                            <!-- 路径占星号列自适应宽度（硬编码 MaxWidth 修复，审查报告2 M7、报告3 P2） -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Path}" FontSize="{StaticResource FontSizeSecondary}"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="{DynamicResource DangerChipBgBrush}"
                                                        CornerRadius="99" Padding="8,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Reason}" FontSize="{StaticResource FontSizeSecondary}"
                                                               Foreground="{DynamicResource DangerChipTextBrush}"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                        <!-- › 字符换矢量箭头 -->
                                        <PathIcon Grid.Column="1" Data="{x:Static local:AppIcons.ChevronRight}" Width="16" Height="16"
                                                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </ToggleButton>
                            </Grid>

                            <!-- 展开详情（FR-A6.3）：完整路径 / 大小 / 原因 / 系统打开 -->
                            <Border IsVisible="{Binding #Row.IsChecked}" Margin="32,0,0,12"
                                    Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                                    CornerRadius="{StaticResource RadiusS}" Padding="12,8">
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="{StaticResource FontSizeSecondary}"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" TextWrapping="Wrap">
                                        <Run Text="完整路径："/><Run Text="{Binding Path}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="{StaticResource FontSizeSecondary}"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}">
                                        <Run Text="大小："/><Run Text="{Binding Size}"/><Run Text=" 字节"/>
                                    </TextBlock>
                                    <TextBlock FontSize="{StaticResource FontSizeSecondary}"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" TextWrapping="Wrap">
                                        <Run Text="指纹："/><Run Text="{Binding Fingerprint}"/>
                                    </TextBlock>
                                    <Button Classes="sm" Margin="0,4,0,0" HorizontalAlignment="Left" Click="OnOpenItem">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{x:Static local:AppIcons.OpenInNew}" Width="14" Height="14"
                                                      Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                            <TextBlock Text="用系统应用打开" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Separator Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,4"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 底部批量操作栏（FR-A6.5）：全选按钮文案随勾选状态在「全选/取消全选」间切换（审查报告3 P2） -->
        <Border Grid.Row="2"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}" Padding="16,12"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,8,*">
                <Button Grid.Column="0" Content="{Binding SelectAllText}" Command="{Binding ToggleSelectAllCommand}"
                        IsEnabled="{Binding !IsMoving}"/>
                <Button Grid.Column="2" Content="批量移动到待处理" Classes="primary"
                        Command="{Binding MoveToPendingCommand}" IsEnabled="{Binding !IsMoving}"/>
            </Grid>
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Styles>
</UserControl>
