<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaOrganizer.Shared.ViewModels"
             x:Class="MediaOrganizer.Android.Views.ReportView"
             x:DataType="vm:ReportViewModel">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A8A8A"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="16" Spacing="8">
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                        BoxShadow="0 1 3 0 #14000000">
                    <StackPanel Spacing="10">
                        <DockPanel>
                            <TextBlock Text="📄 分析报告" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ReportMeta}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                        </DockPanel>
                        <TextBlock Text="{Binding ReportText}" FontSize="11" LineHeight="18"
                                   Foreground="#1B1B1B" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="报告自动保存于应用专有目录，可另存为或分享导出。"
                           FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="4,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作栏：另存为（SAF CREATE_DOCUMENT）/ 系统分享 -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" Padding="16,12"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,8,*">
                <Button Grid.Column="0" Content="📥 另存为（SAF）" Command="{Binding SaveReportCommand}"/>
                <Button Grid.Column="2" Content="📤 分享" Classes="primary" Command="{Binding ShareReportCommand}"/>
            </Grid>
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#0067C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#1975C5"/>
        </Style>
    </UserControl.Styles>
</UserControl>
