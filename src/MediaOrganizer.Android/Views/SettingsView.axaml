<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaOrganizer.Shared.ViewModels"
             x:Class="MediaOrganizer.Android.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0067C0"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#616161"/>
            <Setter Property="Margin" Value="4,8,4,0"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #14000000"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#0067C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="44"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#1975C5"/>
        </Style>
        <Style Selector="Button.sm">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12">

            <!-- ===== 提取器（FR-A8.1） ===== -->
            <TextBlock Classes="sectionTitle" Text="提取器"/>
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <ItemsControl ItemsSource="{Binding Extractors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExtractorSettingVM">
                                <StackPanel Spacing="6" Margin="0,4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding DisplayLabel}" FontSize="14"
                                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                        <Slider Minimum="0" Maximum="2" SmallChange="0.1" LargeChange="0.5"
                                                Value="{Binding Weight}" MinHeight="36"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Weight, StringFormat='{}{0:F1}'}"
                                                   FontSize="12" Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold" Width="36" TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Separator Background="#F0F0F0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Spacing="6">
                        <TextBlock Text="最大年份回溯（max_years_past）" FontSize="12" Foreground="#616161"/>
                        <ComboBox x:Name="MaxYearsCombo" SelectionChanged="OnMaxYearsChanged">
                            <ComboBoxItem Content="20 年"/>
                            <ComboBoxItem Content="30 年"/>
                            <ComboBoxItem Content="50 年"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="未来日期缓冲（future_date_buffer_days）" FontSize="12" Foreground="#616161"/>
                        <ComboBox x:Name="FutureBufferCombo" SelectionChanged="OnFutureBufferChanged">
                            <ComboBoxItem Content="0 天（未来日期归入 FutureDate/）"/>
                            <ComboBoxItem Content="1 天"/>
                            <ComboBoxItem Content="7 天"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== 文件名模式（FR-A8.2） ===== -->
            <TextBlock Classes="sectionTitle" Text="文件名模式"/>
            <Border Classes="card" Padding="8,8,16,8">
                <StackPanel Spacing="4">
                    <ItemsControl ItemsSource="{Binding Patterns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PatternSettingVM">
                                <Grid ColumnDefinitions="*,Auto" MinHeight="52">
                                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="230">
                                            <Run Text="{Binding Regex}"/><Run Text=" · "/><Run Text="{Binding Source}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="#F3F9FD" BorderBrush="#C3DCF1" BorderThickness="1" CornerRadius="8"
                            Padding="12,8" Margin="8,4">
                        <TextBlock Text="提示：如需新增自定义模式，请在桌面版魔术工具中编辑后把 patterns.json 复制到手机。"
                                   FontSize="12" Foreground="#0F4E7D" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== 网络位置（FR-A8.3，FR-A9） ===== -->
            <TextBlock Classes="sectionTitle" Text="网络位置"/>
            <Border Classes="card" Padding="8,8,16,8">
                <StackPanel Spacing="4">
                    <ItemsControl ItemsSource="{Binding NetworkProfiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NetworkProfileVM">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" MinHeight="56" Margin="8,0">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                       Foreground="{StaticResource TextBrush}"/>
                                            <Border Background="#E8F2FB" CornerRadius="10" Padding="8,1">
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="#0F4E7D"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Address}" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                        <TextBlock Text="{Binding VerifiedLabel}" FontSize="10"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="编辑" Classes="sm" Margin="4,0"
                                            Click="OnEditProfile" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Content="删除" Classes="sm" Margin="4,0"
                                            Click="OnDeleteProfile" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Content="测试" Classes="sm"
                                            Click="OnTestProfile" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="*" Margin="8,6">
                        <Button Content="+ 添加网络位置" Command="{Binding BeginAddNetworkCommand}"/>
                    </Grid>

                    <!-- 连接编辑表单（新增/编辑共用，FR-A8.3） -->
                    <Border IsVisible="{Binding EditingNetwork}" Background="#FAFAFA"
                            CornerRadius="8" Padding="12" Margin="8,4" BorderBrush="#E5E5E5" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="类型" FontSize="12" Foreground="#616161"/>
                                <ComboBox ItemsSource="{Binding NetworkTypeOptions}"
                                          SelectedIndex="{Binding EditTypeIndex, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="名称" FontSize="12" Foreground="#616161"/>
                                <TextBox Text="{Binding EditName, Mode=TwoWay}" PlaceholderText="家里的 NAS"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="地址" FontSize="12" Foreground="#616161"/>
                                <TextBox Text="{Binding EditAddress, Mode=TwoWay}" PlaceholderText="\\192.168.1.10\photos 或 https://dav.example.com/dav"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,8,*">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="用户名" FontSize="12" Foreground="#616161"/>
                                    <TextBox Text="{Binding EditUsername, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.ColumnSpan="1" Spacing="6">
                                    <TextBlock Text="密码（Keystore 加密存储）" FontSize="12" Foreground="#616161"/>
                                    <TextBox Text="{Binding EditPassword, Mode=TwoWay}" PasswordChar="•"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding NetworkHint}" FontSize="12" Foreground="#8A3714" TextWrapping="Wrap"
                                       IsVisible="{Binding NetworkHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <Grid ColumnDefinitions="*,8,*,8,*">
                                <Button Grid.Column="0" Content="测试连接" Click="OnTestEditing"/>
                                <Button Grid.Column="2" Content="取消" Command="{Binding CancelNetworkCommand}"/>
                                <Button Grid.Column="4" Content="保存" Classes="primary" Command="{Binding SaveNetworkCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#F3F9FD" BorderBrush="#C3DCF1" BorderThickness="1" CornerRadius="8"
                            Padding="12,8" Margin="8,4">
                        <TextBlock Text="提示：网络目标仅支持复制（copy）；SMB 需账号密码认证（首版不支持匿名）。"
                                   FontSize="12" Foreground="#0F4E7D" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== 扫描参数（FR-A8.4） ===== -->
            <TextBlock Classes="sectionTitle" Text="扫描参数"/>
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="扫描所有文件" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="忽略扩展名白名单" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ScanAllFiles}"/>
                    </Grid>
                    <StackPanel Spacing="6">
                        <TextBlock Text="扩展名白名单（逗号分隔）" FontSize="12" Foreground="#616161"/>
                        <TextBox Text="{Binding SupportedFormatsText, Mode=TwoWay}" MinHeight="72"
                                 AcceptsReturn="True" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="扫描并行度" FontSize="12" Foreground="#616161"/>
                        <ComboBox x:Name="ScanParallelCombo" SelectionChanged="OnScanParallelChanged">
                            <ComboBoxItem Content="自动（CPU 核心数）"/>
                            <ComboBoxItem Content="1（串行）"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="8"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="执行并行度" FontSize="12" Foreground="#616161"/>
                        <ComboBox x:Name="ExecParallelCombo" SelectionChanged="OnExecParallelChanged">
                            <ComboBoxItem Content="自动（本地 2 / 网络 4）"/>
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="4"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding SaveHint}" FontSize="12" Foreground="#107C10" Margin="4,2"
                       TextWrapping="Wrap"
                       IsVisible="{Binding SaveHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <Border Height="16"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
