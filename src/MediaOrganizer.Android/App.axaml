<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MediaOrganizer.Android"
             x:Class="MediaOrganizer.Android.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <!-- 全局画刷：原先在 5 个 View 的 UserControl.Resources 重复定义，上移统一维护 -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0067C0"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#107C10"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C"/>

        <!-- 自打包中文字体（Noto Sans SC，SIL OFL 许可，可随 APK 分发）。
             2026-09-07 真机验证：移除本字体、改走「系统字体 + 按码点回退」后，v1.1.0 中文再次不可见，
             证明该回退路径在本应用（Avalonia 12.1.1 / Android）上确实不可用——**不要再移除本字体**。
             评估与还原方式见 docs/review/2026-09-05-系统字体与并行度评估.md。
             注意 UI 文本避免使用 emoji/生僻符号（本字体不含，见 docs 字体说明）。 -->
        <FontFamily x:Key="AppFont">avares://MediaOrganizer.Android/Fonts/NotoSansSC-Regular.otf#Noto Sans SC</FontFamily>
        <!-- 覆盖 FluentTheme 模板内部引用的主题字体资源键（Button/ComboBox/ContentControl 等）。
             注意：FontFamily 元素的内容按“字体族名字符串”解析，不会展开 {} 标记扩展；
             写成 {StaticResource AppFont} 会构造出同名字符串的非法字体，
             导致依赖 ContentControlThemeFontFamily 的控件中文全部不可见（只有 ASCII/符号可见）。 -->
        <FontFamily x:Key="ContentControlThemeFontFamily">avares://MediaOrganizer.Android/Fonts/NotoSansSC-Regular.otf#Noto Sans SC</FontFamily>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <local:AppTheme />
        <!-- 通用样式：原先在 5 个 View 的 UserControl.Styles 重复定义，上移（Button.primary 统一 48dp 热区） -->
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#616161"/>
            <Setter Property="Margin" Value="4,8,4,0"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #14000000"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#0067C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#1975C5"/>
        </Style>
        <Style Selector="Button.sm">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <!-- 全局字体兜底：TextElement.FontFamily 为可继承附加属性，作用于所有控件
             （含 PopupRoot 弹出层；TextBlock/AccessText 显式命中，避免 ContentPresenter
             生成文本框时漏继承）。注意 Selector 中必须写成 TextElement.FontFamily 附加属性形式，
             裸写 FontFamily 在 Control 上会触发 AVLN2000。 -->
        <Style Selector="Control">
            <Setter Property="TextElement.FontFamily" Value="{StaticResource AppFont}"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="TextElement.FontFamily" Value="{StaticResource AppFont}"/>
        </Style>
        <Style Selector="AccessText">
            <Setter Property="TextElement.FontFamily" Value="{StaticResource AppFont}"/>
        </Style>
    </Application.Styles>
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
</Application>
