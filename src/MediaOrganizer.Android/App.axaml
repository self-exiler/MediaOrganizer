<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MediaOrganizer.Android"
             xmlns:c="using:MediaOrganizer.Android.Controls"
             x:Class="MediaOrganizer.Android.App"
             RequestedThemeVariant="Default">
    <!-- 主题变体由硬编码 Light 改为 Default：跟随系统深浅色（审查报告2 F1、报告3 F2）。
         颜色全部改用 FluentTheme 内置主题资源（System*Color / SystemControl*Brush 系列），
         深色模式无需额外适配。注意：Avalonia 12 的 Fluent 主题没有 WinUI3 风格的
         TextFillColor*Brush / SystemFillColor*Brush / CardBackgroundFillColor* 键，
         报告1 建议的键名按实际键名体系（WinUI1/UWP 风格）映射。 -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- 品牌强调色 #0067C0：覆盖 Fluent 的 SystemAccentColor 及明暗变体，
                 ToggleSwitch/Slider/CheckBox/ProgressBar/TextBox 选区等框架控件全部归位品牌色
                 （审查报告3 F1）。视图内品牌色继续经 AccentBrush 引用（同值）。 -->
            <Color x:Key="SystemAccentColor">#FF0067C0</Color>
            <Color x:Key="SystemAccentColorLight1">#FF408DD0</Color>
            <Color x:Key="SystemAccentColorLight2">#FF7FB3DF</Color>
            <Color x:Key="SystemAccentColorLight3">#FFBFD9EF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF0058A3</Color>
            <Color x:Key="SystemAccentColorDark2">#FF004886</Color>
            <Color x:Key="SystemAccentColorDark3">#FF00396A</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="#FF0067C0"/>

            <!-- 字号梯度（审查报告1 #6、报告2 F9）：Display 22 / Title 16 / Body 14 / Secondary 12，
                 收敛原先 10–24 七档碎片字号；最小字号不低于 12。 -->
            <x:Double x:Key="FontSizeDisplay">22</x:Double>
            <x:Double x:Key="FontSizeTitle">16</x:Double>
            <x:Double x:Key="FontSizeBody">14</x:Double>
            <x:Double x:Key="FontSizeSecondary">12</x:Double>
            <!-- 圆角 token（审查报告2 F7）：RadiusS=8 按钮/输入，RadiusM=12 卡片，chip 用全圆角 99。 -->
            <CornerRadius x:Key="RadiusS">8</CornerRadius>
            <CornerRadius x:Key="RadiusM">12</CornerRadius>

            <!-- 语义色板（成功/信息/警示三种提示 + 危险 chip）：Fluent 主题没有内置语义填充色，
                 自定义 Light/Dark 两套随主题切换（审查报告2 F4、报告3 F2 的 ThemeDictionaries 打底）。 -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SuccessBrush" Color="#FF107C10"/>
                    <SolidColorBrush x:Key="SuccessTipBgBrush" Color="#FFF2FBF2"/>
                    <SolidColorBrush x:Key="SuccessTipBorderBrush" Color="#FFBFE6BF"/>
                    <SolidColorBrush x:Key="SuccessTipTextBrush" Color="#FF0B5A0B"/>
                    <SolidColorBrush x:Key="InfoTipBgBrush" Color="#FFF3F9FD"/>
                    <SolidColorBrush x:Key="InfoTipBorderBrush" Color="#FFC3DCF1"/>
                    <SolidColorBrush x:Key="InfoTipTextBrush" Color="#FF0F4E7D"/>
                    <SolidColorBrush x:Key="WarnTipBgBrush" Color="#FFFFF9F5"/>
                    <SolidColorBrush x:Key="WarnTipBorderBrush" Color="#FFF4D1BC"/>
                    <SolidColorBrush x:Key="WarnTipTextBrush" Color="#FF8A3714"/>
                    <SolidColorBrush x:Key="DangerChipBgBrush" Color="#FFFDECEB"/>
                    <SolidColorBrush x:Key="DangerChipTextBrush" Color="#FFA4262C"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SuccessBrush" Color="#FF6CCB5F"/>
                    <SolidColorBrush x:Key="SuccessTipBgBrush" Color="#FF122B12"/>
                    <SolidColorBrush x:Key="SuccessTipBorderBrush" Color="#FF2C5A2C"/>
                    <SolidColorBrush x:Key="SuccessTipTextBrush" Color="#FF9CDF9F"/>
                    <SolidColorBrush x:Key="InfoTipBgBrush" Color="#FF12283A"/>
                    <SolidColorBrush x:Key="InfoTipBorderBrush" Color="#FF2A5375"/>
                    <SolidColorBrush x:Key="InfoTipTextBrush" Color="#FF99CCF3"/>
                    <SolidColorBrush x:Key="WarnTipBgBrush" Color="#FF2E2113"/>
                    <SolidColorBrush x:Key="WarnTipBorderBrush" Color="#FF6E5433"/>
                    <SolidColorBrush x:Key="WarnTipTextBrush" Color="#FFF2B366"/>
                    <SolidColorBrush x:Key="DangerChipBgBrush" Color="#FF3A1613"/>
                    <SolidColorBrush x:Key="DangerChipTextBrush" Color="#FFFF99A4"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 自打包中文字体（Noto Sans SC，SIL OFL 许可，可随 APK 分发）——不要再移除：
                 系统字体在荣耀真机中文缺失（Avalonia 12 与国产定制 ROM 的兼容性冲突，两条回退路径均已真机否证）。
                 UI 文本避免使用本字体不含的 emoji/生僻符号。 -->
            <FontFamily x:Key="AppFont">avares://MediaOrganizer.Android/Fonts/NotoSansSC-Regular.otf#Noto Sans SC</FontFamily>
            <!-- 覆盖 FluentTheme 模板内部引用的主题字体资源键（Button/ComboBox/ContentControl 等）。
                 注意：FontFamily 元素的内容按“字体族名字符串”解析，不会展开 {} 标记扩展；
                 写成 {StaticResource AppFont} 会构造出同名字符串的非法字体，
                 导致依赖 ContentControlThemeFontFamily 的控件中文全部不可见（只有 ASCII/符号可见）。 -->
            <FontFamily x:Key="ContentControlThemeFontFamily">avares://MediaOrganizer.Android/Fonts/NotoSansSC-Regular.otf#Noto Sans SC</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <local:AppTheme />
        <!-- 通用样式：原先在 5 个 View 的 UserControl.Styles 重复定义，上移统一维护。
             触屏机无悬停：pointerover 态删除（审查报告1 #3），按压反馈统一 :pressed（报告2 F3、报告3 F3）。 -->
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"/>
            <Setter Property="Margin" Value="4,8,4,0"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusM}"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #14000000"/>
        </Style>
        <!-- 提示条三件套（审查报告1 #2、报告2 F4）：Border.tip 基类 + 语义类；内文颜色由后代选择器带出。 -->
        <Style Selector="Border.tip">
            <Setter Property="CornerRadius" Value="{StaticResource RadiusS}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.infoTip">
            <Setter Property="Background" Value="{DynamicResource InfoTipBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InfoTipBorderBrush}"/>
        </Style>
        <Style Selector="Border.infoTip TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InfoTipTextBrush}"/>
        </Style>
        <Style Selector="Border.successTip">
            <Setter Property="Background" Value="{DynamicResource SuccessTipBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessTipBorderBrush}"/>
        </Style>
        <Style Selector="Border.successTip TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SuccessTipTextBrush}"/>
        </Style>
        <Style Selector="Border.warnTip">
            <Setter Property="Background" Value="{DynamicResource WarnTipBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarnTipBorderBrush}"/>
        </Style>
        <Style Selector="Border.warnTip TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarnTipTextBrush}"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusS}"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        </Style>
        <!-- 主按钮按压/禁用态：原样式只声明 :pointerover 且覆盖了 Fluent 自带 :pressed，
             触屏上主按钮零反馈（审查报告2 F3、报告3 F3）。 -->
        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="#005A9E"/>
        </Style>
        <Style Selector="Button.primary:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Button.sm">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <!-- 行内透明按钮（整行点击进编辑等）：Background 覆盖了 Fluent 按压底色，
             须显式补 :pressed（应用级样式后于主题，无差别压制各状态背景） -->
        <Style Selector="Button.rowAction">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusS}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.rowAction:pressed">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
        </Style>
        <!-- 触屏选择字段（OptionPicker，审查报告2 §2.3 配套控件）：48dp 热区 + 输入框观感。
             它继承 Button，但改成「点按弹单选对话框」后原位置只剩一行文字 + 箭头，真机上看不出可点；
             这里补上与「选取」路径框一致的浅底/描边/圆角，并显式补 :pressed（覆盖背景会压掉 Fluent 的）。 -->
        <Style Selector="c|OptionPicker">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusS}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>
        <Style Selector="c|OptionPicker:pressed">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
        </Style>
        <Style Selector="c|OptionPicker:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <!-- Button 模板不保证把 Foreground 传给子控件：文字与箭头显式跟随深浅色 -->
        <Style Selector="c|OptionPicker TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>
        <Style Selector="c|OptionPicker PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"/>
        </Style>
        <!-- 全局字体兜底：TextElement.FontFamily 为可继承附加属性，作用于所有控件
             （含 PopupRoot 弹出层；TextBlock/AccessText 显式命中，避免 ContentPresenter
             生成文本框时漏继承）。注意 Selector 中必须写成 TextElement.FontFamily 附加属性形式，
             裸写 FontFamily 在 Control 上会触发 AVLN2000。 -->
        <Style Selector="Control">
            <Setter Property="TextElement.FontFamily" Value="{StaticResource AppFont}"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="TextElement.FontFamily" Value="{StaticResource AppFont}"/>
        </Style>
        <Style Selector="AccessText">
            <Setter Property="TextElement.FontFamily" Value="{StaticResource AppFont}"/>
        </Style>
    </Application.Styles>
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
</Application>
