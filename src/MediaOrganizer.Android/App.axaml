<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MediaOrganizer.Android"
             x:Class="MediaOrganizer.Android.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <!-- 字体策略：使用系统默认字体 + Avalonia 按码点系统回退（FluentTheme 默认主题字体键
             均指向 FontManager 默认族，CJK 由各机型系统字体命中：荣耀 HarmonyOS/HONOR Sans、
             原生 Noto Sans CJK SC、小米 MiSans 等）。
             历史：初版曾自打包 NotoSansSC 并覆盖主题字体键，彼时「中文不可见」实为
             ContentControlThemeFontFamily 写成元素内容形式 {StaticResource AppFont} 的代码错误
             （FontFamily 元素内容按字面族名解析 → 非法字体 → 按码点回退一并失效），d1104aa 修复；
             系统字体路径当时从未被真正验证。2026-09-06 移除全部字体覆盖与自打包字体
             （APK 预计减 3.5~5MB，评估与真机验证清单见 docs/review/2026-09-05-系统字体与并行度评估.md）。
             若个别机型 CJK 空白：首选 git 还原本次改动，其次 FontManagerOptions.FontFallbacks
             显式列出系统 CJK 族名。 -->
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <local:AppTheme />
    </Application.Styles>
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
</Application>
