<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>33.0</SupportedOSPlatformVersion>
    <TargetPlatformVersion>36.0</TargetPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ApplicationId>org.mediaorganizer.android</ApplicationId>
    <ApplicationTitle>MediaOrganizer</ApplicationTitle>
    <!-- ApplicationVersion = Android versionCode（整数，必须单调递增，否则覆盖安装会被
         INSTALL_FAILED_VERSION_DOWNGRADE 拒绝）。CI 发版时由 release.yml 用 git 提交总数
         自动生成并覆盖（-p:ApplicationVersion），此处数值仅作本地构建兜底，无需手工递增。
         ApplicationDisplayVersion = versionName，CI 发版时由 -p:ApplicationDisplayVersion=<tag 去掉前导 v> 覆盖。 -->
    <ApplicationVersion>3</ApplicationVersion>
    <ApplicationDisplayVersion>1.1.1</ApplicationDisplayVersion>
    <AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>
    <!-- .NET Android 默认处理器 AndroidMessageHandler 底层是 Java HttpURLConnection，
         不认识 WebDAV 扩展方法，PROPFIND 会被直接拒绝（"Expected one of [OPTIONS, GET, ...]
         but was PROPFIND"，请求根本发不出去）。切到 .NET 自带 SocketsHttpHandler 后支持任意
         HTTP 方法，且直连套接字不受 Java 层 HttpURLConnection 限制。 -->
    <AndroidHttpClientHandlerType>System.Net.Http.SocketsHttpHandler, System.Net.Http</AndroidHttpClientHandlerType>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- r8 压缩 Java 侧 dex：2026-10-04 实测 classes.dex 7,792,992 → 2,791,248（压缩后 2,680,238 →
         1,131,986），APK 25,157,454 → 23,609,223（−1.55MB）。它只动 Java/dex，不需要 IL 裁剪
         （AndroidLinkMode 仍为 None，无 IL2xxx 告警）；叠加 PublishTrimmed 只再多 0.3MB 噪声。
         副作用：AndroidDexTool 自动转 d8、desugaring 打开，并生成 $(OutputPath)mapping.txt——
         崩溃栈里的混淆名要靠它还原，release.yml 已将其作为 Actions 产物归档（不进公开 Release）。
         真机回归（荣耀 PGT-AN10 / arm64）：冷启动 1382/1260/1247ms（无 r8 基线 1242ms，无可测差异）、
         SAF 选目录全流程（含重新授权）、中文渲染、只读分析 37 文件通过、logcat 零异常。 -->
    <AndroidLinkTool>r8</AndroidLinkTool>
    <!-- IL 裁剪：2026-10-04 真机实测后**不开**。工作负载虽报 XA1030（AOT 但不裁剪），但收益太小：
         PublishTrimmed=true 时 AndroidLinkMode 自动取 SdkOnly / TrimMode=partial，libassembly-store.so
         原始大小一字不变（13,958,520B），APK 25.16MB → 24.86MB（−0.3MB）；再显式 -p:AndroidLinkMode=Full
         也只到 24.37MB（store −0.83MB、libaot 88→80 个），累计 −1.9%。
         代价却不小：Full 图下暴露 6×IL2026 + 2×IL2072（静态 ViewLocator 的 Assembly.GetType(String)
         正是页面解析入口，类型可能被裁掉）+ IL2104 整程序集告警（SMBLibrary、TagLibSharp）。
         若将来真要开：先给 ViewLocator 的候选类型加 DynamicDependency/保留描述符，再整轮真机回归。 -->
    <!-- Profiled AOT（工作负载自带 dotnet.aotprofile）：Release + MonoVM 下 RunAOTCompilation 默认为 true，
         此前显式写 false 关掉 profiled 反而走了「全部程序集无差别完整 AOT」的最贵路径——实测 88 个
         libaot-*.dll.so 共 9.6MB（占 APK 30%）。改为 true（即工作负载默认值）后仍每程序集一个 .so，
         但只预热 profile 内的方法，AOT 段压到 2.0MB，APK 实测 32.8MB → 25.2MB。
         冷启动已真机复测（荣耀 PGT-AN10，arm64）：完整 AOT 1368/1232/1239ms，profiled AOT 1357/1203/1174ms，
         未命中 profile 的解释器回退没有可测代价。 -->
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
    <!-- 只打 arm64：实测设备为 arm64，默认会额外打 x86_64 一套。
         .NET 10 为满足 Android 16 的 16KB 页面对齐，把每个程序集都包成独立
         ELF 共享库（lib_<Assembly>.dll.so），本项目共 345 个程序集 → 双架构 690 个 .so，
         APK 93MB、构建 6 分钟。限单架构后 APK 与构建时间约减半，启动加载的 .so 也减半。
         注意：.NET 10 已废弃 AndroidSupportedAbis（XA0036），改用标准 RuntimeIdentifiers，
         RID 名为 android-arm64 / android-x64 / android-arm / android-x86。 -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <!-- 完整打包：禁用共享运行时，APK 自包含、脱离 VS 可独立运行
         （否则卸载重装后 APK 残缺，点击卡启动界面 ANR 闪退）。 -->
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <!-- 关闭 VS「快速部署(Fast Deployment)」——这才是真正的开关。
         注意：AndroidUseSharedRuntime=false 只禁用「共享 Mono 运行时」，并不关闭快速部署。
         快速部署会走两段式流程：启动一次 → run-as 推送程序集到
         /data/data/<pkg>/files/.__override__ → force-stop → 再启动一次。
         在荣耀 PGT-AN10(Android 16/API 36) 上实测第二段启动未执行，进程在首次启动后
         156ms 被 adb shell am force-stop 杀掉，表现为 VS 调试启动闪退（adb 手动启动正常）。
         EmbedAssembliesIntoApk=true 让程序集直接进 APK，部署退化为
         「install → 一次启动」，消除 force-stop 环节。
         （此前记录的「打包卡死」实为 aapt2 daemon 挂死，已由下方 AndroidUseDaemonAapt2=false 解决。） -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- aapt2 daemon 模式在部分机器上挂死（dotnet/android 已知问题）：改用一次性调用，跨机可移植 -->
    <AndroidUseDaemonAapt2>false</AndroidUseDaemonAapt2>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Xamarin.AndroidX.DocumentFile" />
    <!-- 前台服务进度通知的 NotificationCompat.Builder / NotificationManagerCompat（AndroidX.Core）。
         该包本就经 Avalonia.Android → AppCompat 链传递打包进 APK，显式引用不增加体积。 -->
    <PackageReference Include="Xamarin.AndroidX.Core" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <!-- 8.3：已删除原 Magick.NET ExcludeAssets="native" 补丁——
       Shared 现为条件多目标（net10.0-android），Android 下其引用的 Core 用 net10.0-android 版本（不含 Magick.NET），
       Magick 原生库不再进入 Android 闭包，16KB 页面对齐（XA0141）问题随之消除。
       2026-10-04 更正：该条件多目标自 09-05 起从未真正生效——Core/Shared 的工作负载检测条件恒为 false
       （见 Core.csproj 注释），期间 APK 一直带着 Magick.NET 约 15MB。条件修正后 Magick 与
       System.Security.Cryptography.ProtectedData 均已从 APK 消失，#if ANDROID 平台分支首次真正编译。 -->

  <!-- 内嵌中文字体（Noto Sans SC，SIL OFL）：放 Fonts/ 而非 Assets/，避免 .NET Android 把
       Assets/** 自动标记为 AndroidAsset 与 AvaloniaResource 冲突。
       不要再删——系统字体在荣耀真机中文缺失（Avalonia 与国产定制 ROM 的兼容性冲突），代价是 APK 增约 7MB。
       评估见 docs/review/2026-10-04-踩坑记录-Avalonia-Android-中文字体.md。 -->
  <ItemGroup>
    <AvaloniaResource Include="Fonts\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaOrganizer.Core\MediaOrganizer.Core.csproj" />
    <ProjectReference Include="..\MediaOrganizer.Shared\MediaOrganizer.Shared.csproj" />
  </ItemGroup>

</Project>
