<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>33.0</SupportedOSPlatformVersion>
    <TargetPlatformVersion>36.0</TargetPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ApplicationId>org.mediaorganizer.android</ApplicationId>
    <ApplicationTitle>MediaOrganizer</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- 完整打包：禁用共享运行时，APK 自包含、脱离 VS 可独立运行
         （否则卸载重装后 APK 残缺，点击卡启动界面 ANR 闪退）。
         注意：不要同时设 EmbedAssembliesIntoApk=true —— 实测会让打包阶段
         （_CompressAssemblies 之后）长时间卡死；仅 AndroidUseSharedRuntime=false
         已足以生成 26MB 的独立 APK，并经 adb 验证可独立启动。 -->
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <!-- aapt2 daemon 模式在部分机器上挂死（dotnet/android 已知问题）：改用一次性调用，跨机可移植 -->
    <AndroidUseDaemonAapt2>false</AndroidUseDaemonAapt2>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Android" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Xamarin.AndroidX.DocumentFile" Version="1.0.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
  </ItemGroup>

  <!-- 内嵌中文字体（Noto Sans SC，SIL OFL）：放 Fonts/ 而非 Assets/，避免 .NET Android 把
       Assets/** 自动标记为 AndroidAsset 与 AvaloniaResource 冲突 -->
  <ItemGroup>
    <AvaloniaResource Include="Fonts\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaOrganizer.Core\MediaOrganizer.Core.csproj" />
    <ProjectReference Include="..\MediaOrganizer.Shared\MediaOrganizer.Shared.csproj" />
  </ItemGroup>

</Project>
